{
  "name": "neuro-map-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ADHD/dyslexia-friendly HTML learning app and editable neuroscience-informed learning map harness for Codex development.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "doctor": "node scripts/doctor.mjs",
    "check": "npm run doctor && npm run lint && npm run build && npm run test:e2e",
    "package:review": "node scripts/create-review-zip.mjs",
    "package:verify": "node scripts/verify-review-zip.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "idb-keyval": "^6.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
